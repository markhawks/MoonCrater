<VirtualHost *:80>
    ServerName mooncreater.example.test
    DocumentRoot /opt/mooncreater/public

    <Directory /opt/mooncreater/public>
        Options -Indexes +FollowSymLinks
        AllowOverride FileInfo Options AuthConfig Limit
        Require all granted
    </Directory>

    # Keep real values in a root-owned local file, not in Git.
    IncludeOptional /etc/mooncreater/apache-env.conf

    ErrorLog logs/mooncreater-error.log
    CustomLog logs/mooncreater-access.log combined
</VirtualHost>
